# Copy to .env and fill in. Any OpenAI-compatible /chat/completions endpoint works.
# DeepSeek (deepseek-chat was retired in July 2026; use deepseek-flash):
EVOPLAN_BASE_URL=https://api.deepseek.com/v1
EVOPLAN_API_KEY=
EVOPLAN_MODEL=deepseek-flash
# Qwen via Alibaba Cloud Bailian (OpenAI-compatible mode):
# EVOPLAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EVOPLAN_MODEL=qwen-plus
